# https://vercel.com/docs/storage/vercel-postgres
POSTGRES_URL=

NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET= # https://generate-secret.vercel.app/32

# https://authjs.dev/getting-started/providers/github
# Needed in production only. In development, sign-in uses Mockatoo's mock of
# GitHub, so you can leave these empty.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: a free Mockatoo test account (https://app.mockatoo.globalunderdog.com)
# for the full sign-in test in `pnpm test:e2e`. It is skipped when these are empty.
MOCKATOO_TEST_EMAIL=
MOCKATOO_TEST_PASSWORD=
